{
  "openapi": "3.1.0",
  "info": {
    "title": "Octopus Wheel Spinner",
    "description": "Health and recorded wheel of fortune spin attempts. The endpoints have no authentication.",
    "version": "1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "description": "Returns 200 whenever the service is running. `octopus` reports whether the Octopus API is reachable, from a background check cached for 30 seconds; it is `unknown` until the first check finishes.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The service is running",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Health" }
              }
            }
          }
        }
      }
    },
    "/spins": {
      "get": {
        "summary": "Recorded spin attempts",
        "description": "Returns the recorded spin attempts, newest first, with a summary. The summary applies the `fuel` and `success` filters but ignores `limit`.",
        "operationId": "getSpins",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum attempts returned",
            "schema": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
          },
          {
            "name": "fuel",
            "in": "query",
            "description": "Only attempts for this fuel",
            "schema": { "type": "string", "enum": ["electricity", "gas"] }
          },
          {
            "name": "success",
            "in": "query",
            "description": "Only successful (`true`) or failed (`false`) attempts",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Spin attempts and summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Spins" }
              }
            }
          },
          "400": {
            "description": "A query parameter is invalid",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": ["status", "octopus", "error"],
        "properties": {
          "status": { "type": "string", "enum": ["healthy"] },
          "octopus": { "type": "string", "enum": ["reachable", "unreachable", "unknown"] },
          "error": {
            "type": ["string", "null"],
            "description": "Why the Octopus API is unreachable",
            "examples": ["api.octopus.energy: TaskCanceledException"]
          }
        }
      },
      "Spins": {
        "type": "object",
        "required": ["summary", "attempts"],
        "properties": {
          "summary": { "$ref": "#/components/schemas/SpinSummary" },
          "attempts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SpinAttempt" }
          }
        }
      },
      "SpinSummary": {
        "type": "object",
        "required": ["attempts", "successful", "failed", "totalPointsWon"],
        "properties": {
          "attempts": { "type": "integer" },
          "successful": { "type": "integer" },
          "failed": { "type": "integer" },
          "totalPointsWon": { "type": "integer" }
        }
      },
      "SpinAttempt": {
        "type": "object",
        "required": ["id", "attemptedAt", "fuel", "success", "pointsWon", "error"],
        "properties": {
          "id": { "type": "integer" },
          "attemptedAt": { "type": "string", "format": "date-time" },
          "fuel": { "type": "string", "enum": ["Electricity", "Gas"] },
          "success": { "type": "boolean" },
          "pointsWon": { "type": ["integer", "null"], "description": "Null on failure" },
          "error": { "type": ["string", "null"], "description": "Null on success" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      }
    }
  }
}
